#!/bin/sh
#
# An example hook script to verify what is about to be committed.
# Called by "git commit" with no arguments.  The hook should
# exit with non-zero status after issuing an appropriate message if
# it wants to stop the commit.
#
# To enable this hook, rename this file to "post-commit".
#PREPUHS_VERSION_12
current_dir=$(pwd)
git_file="$current_dir/.git"
result=0
if [ -x .git/hooks/post-commit ]; then
    .git/hooks/post-commit "$@"
    result=$?
elif [ -f "$git_file" ]; then
    gitdir_path=$(grep 'gitdir:' "$git_file" | awk '{print $2}')
    if [ -n "$gitdir_path" ]; then
       repo_path=$(echo "$gitdir_path" | sed 's|/\.git.*||')
       excutegitFile=$repo_path/.git/hooks/post-commit
       if [ -x $excutegitFile ]; then
          $excutegitFile "$@"
          result=$?
      fi
    fi
fi
exit $result
