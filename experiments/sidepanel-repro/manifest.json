{
  "manifest_version": 3,
  "name": "SidePanel Repro (multi-variant)",
  "version": "0.2.0",
  "description": "Minimal MV3 to reproduce Chrome side panel blank-render bug. Multi-variant phase: A baseline, B windows.update+focus, C windowId, D FAB control.",
  "permissions": ["sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "A) baseline action click"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "variant-b-focus-then-open": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "B) windows.update({focused}) then sidePanel.open({tabId})"
    },
    "variant-c-window-id": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "C) sidePanel.open({windowId})"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
