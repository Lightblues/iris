[Unit]
Description=iris server (sync, relay, export)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/data/projects/app/iris/services/server
EnvironmentFile=/data/projects/app/iris/services/server/.env
ExecStart=/usr/local/bin/node src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
